TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here     # get this by sending /start to your bot once
GROQ_API_KEY=your_groq_api_key_here    # primary AI — free at console.groq.com
GEMINI_API_KEY=your_gemini_api_key_here  # fallback AI — used if Groq is unavailable
GEMINI_TTS_VOICE=Charon                 # optional Gemini TTS voice; Charon is a natural lower voice
PA_ACCESS_TOKEN=pick_a_long_random_string
TELEGRAM_SETUP_CODE=pick_a_different_random_string
WEBHOOK_URL=https://your-deployment-url.railway.app   # set in production, leave unset for local dev
PORT=3000
JWT_SECRET=generate_a_unique_48_byte_hex_secret_before_deploying
APP_URL=https://your-deployment-url.railway.app
# Required in production for new accounts. Create a Resend account, verify a
# sending domain, then use a sender such as: Core PA <hello@yourdomain.com>
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Core PA <hello@yourdomain.com>
# The one existing owner allowed to claim pre-account legacy rows. Once the
# migration has run it can stay set; no other account can claim those rows.
LEGACY_DATA_OWNER_EMAIL=you@example.com
